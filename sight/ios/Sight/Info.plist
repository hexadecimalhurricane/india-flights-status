<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSCameraUsageDescription</key>
  <string>Sight uses the camera to describe what is in front of you.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Sight uses the microphone to detect ambient sounds (sirens, vehicles, alarms) and to listen for voice commands.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Sight uses on-device speech recognition for voice commands like "describe" and "read".</string>
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>
  <key>UIRequiresFullScreen</key>
  <true/>
  <key>UIStatusBarHidden</key>
  <true/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
</dict>
</plist>
